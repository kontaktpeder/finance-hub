# .env = public anon/publishable keys (committed for Lovable Vite builds).
# Put SERVICE_ROLE and other secrets in .env.local (gitignored).

SUPABASE_PROJECT_ID=your_project_id
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# --- Identity Core: Nexus as auth authority (put in .env.local after JWT align) ---
# Keep SUPABASE_* above as this module's data project.
# See Nexus docs/IDENTITY_CORE.md
# AUTH_SUPABASE_URL=https://cjkebodisgqejrpvanna.supabase.co
# AUTH_SUPABASE_PUBLISHABLE_KEY=<nexus anon from Nexus .env>
# VITE_AUTH_SUPABASE_URL=https://cjkebodisgqejrpvanna.supabase.co
# VITE_AUTH_SUPABASE_PUBLISHABLE_KEY=<nexus anon from Nexus .env>
# NEXUS_APP_URL=https://your-nexus.lovable.app
# VITE_NEXUS_APP_URL=https://your-nexus.lovable.app
# PUBLIC_APP_URL=https://your-finance.lovable.app

# --- Google Gemini (same as Nexus: receipt scan etc.) ---
# Create at https://aistudio.google.com/apikey — store as Lovable Secret / .env.local
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=  # optional alias for the same key

# --- Secrets → .env.local only ---
# SUPABASE_SERVICE_ROLE_KEY=
